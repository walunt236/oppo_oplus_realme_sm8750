# custom：临时试验用。派发时选 profile=custom，改这里的开关并提交即可，
# 不必污染 stable。稳定下来后再合并回 stable.env。
# 注意：14 个键必须齐全（lint 会校验），不要删行。
SUSFS_ENABLE=true
KPM_ENABLE=false
LZ4KD_ENABLE=true
DROIDSPACES_ENABLE=false
REKERNEL_ENABLE=false
BASEBAND_GUARD=false
ADIOS_ENABLE=true
BBR3_ENABLE=true
SCHED_ENABLE=true
LZ4ZSTD_ENABLE=true
F2FS_ENABLE=true
BORE_ENABLE=false
RCU_NOCB_ENABLE=true
O3_SELECTIVE=true
