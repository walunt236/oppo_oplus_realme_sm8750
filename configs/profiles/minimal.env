# minimal：关掉所有可选特性，用于二分定位「某个问题是补丁/特性引入的，还是上游本来就有的」。
# 保留的只有内核必需项：LTO、HZ、IP_SET、SECTION_MISMATCH 等由 config_inject.sh 无条件注入。
SUSFS_ENABLE=false
KPM_ENABLE=false
LZ4KD_ENABLE=false
DROIDSPACES_ENABLE=false
REKERNEL_ENABLE=false
BASEBAND_GUARD=false
ADIOS_ENABLE=false
BBR3_ENABLE=false
SCHED_ENABLE=false
LZ4ZSTD_ENABLE=false
F2FS_ENABLE=false
BORE_ENABLE=false
RCU_NOCB_ENABLE=false
O3_SELECTIVE=false
