# UBSAN / KUNIT 配置片段（从 config_inject.sh 抽出）
CONFIG_UBSAN=y
# UBSAN_TRAP 默认关：UB 退化为 WARN 而不是 BUG（崩溃）。
# CONFIG_UBSAN 保持 =y：lib/ubsan.c 的 __ubsan_handle_* 是 EXPORT_SYMBOL，
# 关掉会让带 UBSAN 插桩的 vendor 模块加载失败（Unknown symbol）。
# CONFIG_UBSAN_TRAP is not set
CONFIG_CC_HAS_UBSAN_ARRAY_BOUNDS=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_ARRAY_BOUNDS=y
CONFIG_UBSAN_LOCAL_BOUNDS=y
CONFIG_UBSAN_SANITIZE_ALL=n
CONFIG_KUNIT=m
CONFIG_KUNIT_DEBUGFS=y
