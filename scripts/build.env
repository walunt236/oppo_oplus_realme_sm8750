# 构建参数集中定义（唯一来源）。所有脚本经 common.sh 自动 source。
# 任意项都可用环境变量覆盖：CCACHE_SIZE=30G BUILD_JOBS=8 bash scripts/build_kernel.sh

# 并行度：显式固定 12
#   kbuild 虚拟机 16 核 / 30G，12 线程稳态约 22G，留 8G 给系统与 IO
#   换机器改这里，或用 BUILD_JOBS=xx 覆盖
BUILD_JOBS="${BUILD_JOBS:-12}"

# ccache 上限（磁盘 60G，out 约 25G，20G 为安全上限）
CCACHE_SIZE="${CCACHE_SIZE:-20G}"

# 产物输出目录
OUT_DIR="${OUT_DIR:-$HOME/share/out}"

# 代理地址；留空 = 直连（本机不需要）
PROXY_URL="${PROXY_URL:-}"

# AutoFDO
AFDO_ENABLE="${AFDO_ENABLE:-false}"
AFDO_PROFILE="${AFDO_PROFILE:-$HOME/.cache_patches/afdo/kernel.afdo}"
AFDO_VMLINUX="${AFDO_VMLINUX:-}"

# 骁龙(QCOM)上游合并源：以 OnePlus BSP 基线 tag 为基点，三方合并到最新骁龙 tag
QCOM_REPO="${QCOM_REPO:-https://git.codelinaro.org/clo/la/kernel/msm}"
QCOM_BASE_TAG="${QCOM_BASE_TAG:-}"   # 留空=从一加提交信息自动解析
QCOM_MERGE="${QCOM_MERGE:-true}"

# ---- 工具链（唯一来源）----
# 换编译器只改这一段：目录名与下载地址都由 CLANG_RELEASE 推导
CLANG_RELEASE="${CLANG_RELEASE:-19.0.0git-20240723}"
CLANG_DIR_NAME="${CLANG_DIR_NAME:-Clang-$CLANG_RELEASE}"
CLANG_URL="${CLANG_URL:-https://github.com/ZyCromerZ/Clang/releases/download/$CLANG_RELEASE-release/$CLANG_DIR_NAME.tar.gz}"
# Android 宿主工具（bison/flex 等），解压后 build-tools/bin 进 PATH
BUILD_TOOLS_DIR_NAME="${BUILD_TOOLS_DIR_NAME:-build-tools-main}"

# ---- 外部仓库（换自己的 fork/镜像只改这里）----
OEM_REPO="${OEM_REPO:-https://github.com/OnePlusOSS/android_kernel_common_oneplus_sm8750.git}"
OEM_VENDOR_REPO="${OEM_VENDOR_REPO:-https://github.com/OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8750.git}"
AK3_REPO="${AK3_REPO:-https://github.com/walunt236/AnyKernel3}"

# 工作流未填 kernel_suffix 时使用的默认后缀
KERNEL_SUFFIX_DEFAULT="${KERNEL_SUFFIX_DEFAULT:-oneplus13-4k-aosp16}"
