# 构建参数集中定义（唯一来源）。所有脚本经 common.sh 自动 source。
# 任意项都可用环境变量覆盖：CCACHE_SIZE=30G BUILD_JOBS=8 bash scripts/build_kernel.sh

# 并行度：显式固定 12
#   本机 16 核 / 30G，12 线程稳态约 22G，留 8G 给系统与 IO
#   换机器改这里，或用 BUILD_JOBS=xx 覆盖
BUILD_JOBS="${BUILD_JOBS:-12}"

# ccache 上限（磁盘 60G，out 约 25G，20G 为安全上限）
CCACHE_SIZE="${CCACHE_SIZE:-20G}"

# 产物输出目录
OUT_DIR="${OUT_DIR:-$HOME/ak3-out}"

# 代理地址；留空 = 直连（本机不需要）
PROXY_URL="${PROXY_URL:-}"

# AutoFDO
AFDO_ENABLE="${AFDO_ENABLE:-false}"
AFDO_PROFILE="${AFDO_PROFILE:-$HOME/.cache_patches/afdo/kernel.afdo}"
AFDO_VMLINUX="${AFDO_VMLINUX:-}"
