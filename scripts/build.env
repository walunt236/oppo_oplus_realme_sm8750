# 构建参数集中定义（唯一来源）。所有脚本经 common.sh 自动 source。
# 任意项都可用环境变量覆盖：CCACHE_SIZE=30G BUILD_JOBS=8 bash scripts/build_kernel.sh

# 并行度：取「核数 × 内存」的较小值
#   核数侧 = nproc*3/4（16 核 → 12）
#   内存侧 = (总内存GB - 4) / 2（每 job 约 2GB，另留 4GB 给系统）
#   16核/30G → 12；16核/16G → 6；32核/64G → 24
_CPU_JOBS=$(( $(nproc) * 3 / 4 ))
[ "$_CPU_JOBS" -lt 1 ] && _CPU_JOBS=1
_MEM_GB=$(( $(awk '/^MemTotal:/ {{printf "%d", $2/1024/1024}}' /proc/meminfo) ))
if [ "$_MEM_GB" -ge 4 ]; then
  _MEM_JOBS=$(( (_MEM_GB - 4) / 2 ))
  [ "$_MEM_JOBS" -lt 1 ] && _MEM_JOBS=1
else
  echo "[WARN] 检测到内存仅 $_MEM_GB GB（动态内存空闲收缩？），并行度退回按核数计算" >&2
  echo "[WARN] 构建机建议用静态内存 24-30GB，或用 BUILD_JOBS 显式指定" >&2
  _MEM_JOBS=$_CPU_JOBS
fi
BUILD_JOBS="${BUILD_JOBS:-$(( _CPU_JOBS < _MEM_JOBS ? _CPU_JOBS : _MEM_JOBS ))}"
unset _CPU_JOBS _MEM_GB _MEM_JOBS

# ccache 上限（磁盘 60G，out 约 25G，20G 为安全上限）
CCACHE_SIZE="${CCACHE_SIZE:-20G}"

# 产物输出目录
OUT_DIR="${OUT_DIR:-$HOME/ak3-out}"

# 代理地址；留空 = 直连（本机不需要）
PROXY_URL="${PROXY_URL:-}"

# AutoFDO
AFDO_ENABLE="${AFDO_ENABLE:-false}"
AFDO_PROFILE="${AFDO_PROFILE:-$HOME/.cache_patches/afdo/kernel.afdo}"
AFDO_VMLINUX="${AFDO_VMLINUX:-}"
